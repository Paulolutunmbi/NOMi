MONGODB_URI=
PORT=5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback
GOOGLE_OAUTH_STATE_SECRET=
# A 32-byte base64 value or a 64-character hexadecimal value.
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_SUCCESS_REDIRECT_URI=http://localhost:5173
# AI provider configuration. GROQ_API_KEY belongs only in server/.env.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Tried once if the primary model is rate limited (must support json_schema output).
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
CLOUDINARY_URL=